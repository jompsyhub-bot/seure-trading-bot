# ----------------------------------------------------------------------------
# Live trading (real money)
# ----------------------------------------------------------------------------
# Master kill switch for OKX live trading. When false:
#   * Users cannot open a live connection (POST /api/okx/connect returns 503)
#   * Any existing live session is refused at the next scan tick
# When true:
#   * LIVE_CONFIRMATION_CODE MUST also be set or the app refuses to boot
#   * Users can connect a live OKX trade-only API key and start live sessions
#
# Keep this false until you have run the bot on OKX Demo for at least 2 weeks
# and are satisfied with the trade behavior you've observed.
ALLOW_LIVE_TRADING=false

# A high-entropy phrase (min 16 characters recommended) the user must type
# when opening a live connection. If empty, live trading is impossible
# regardless of ALLOW_LIVE_TRADING.
#
# Example: LIVE_CONFIRMATION_CODE=I-understand-live-trades-use-real-money-7xK9
LIVE_CONFIRMATION_CODE=

# Legacy Bybit path (still referenced by older code, safe to leave empty).
OKX_API_KEY=
OKX_API_SECRET=
OKX_TESTNET=true

# ----------------------------------------------------------------------------
# Credential encryption
# ----------------------------------------------------------------------------
# Fernet key used to encrypt users' API credentials at rest.
# Create with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
